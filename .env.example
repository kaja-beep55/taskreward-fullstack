# ============================================================
# TaskReward Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# NEVER put real secrets in this template.
# ============================================================

# ============================================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# Your Supabase project URL
# Format: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for browser)
# This is safe to expose — it only has permissions allowed by RLS policies
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Publishable key (alternative format, also safe for browser)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# ============================================================
# SUPABASE MANAGEMENT (for database operations only)
# ============================================================
# Personal Access Token — ONLY for migrations/admin tasks
# Get from: https://supabase.com/dashboard/account/tokens
# NEVER commit this. NEVER expose in frontend code.
# Only use in secure terminal/scripts, then unset.
SUPABASE_ACCESS_TOKEN=sbp_YOUR_ACCESS_TOKEN_HERE

# Service Role Key — ONLY for backend Edge Functions
# Get from: https://supabase.com/dashboard/project/_/settings/api
# NEVER commit this. NEVER expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# WhatsApp number for task submissions (no + or spaces, just country code + number)
# Example: 919876543210 for India, 8801712345678 for Bangladesh
WHATSAPP_NUMBER=10000000000

# Application name
APP_NAME=TaskReward

# Default task status when admin creates new task
DEFAULT_TASK_STATUS=draft

# Coin to currency conversion rate (for future withdrawal system)
# Example: 0.10 means 100 coins = 10 BDT
COIN_TO_BDT_RATE=0.10
